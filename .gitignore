#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ----- Security: never commit signing keys or local env -----
# Release keystores (production signing). Losing these = losing the ability to
# update the app on Play Store, so they live OUTSIDE the repo.
*.jks
*.keystore
# Holds the keystore password / alias for release builds.
android/key.properties
# Local secrets (Codemagic / API keys / etc).
.env
.env.local
*.env

# Codemagic build artifacts pulled locally.
codemagic_export/
